# Build / runtime artifacts (regenerated when an env boots) — never tracked.
**/node_modules/
**/.vite/
**/dist/
**/__pycache__/
*.pyc
*.pyo

# SQLite runtime journal files.
*.db-journal
*.db-shm
*.db-wal

# Large grounding databases are downloaded separately (see each env's README),
# not committed. The datepicker / nested_filter DBs are small and ARE committed.
echostay/echostay.db
echoforge/echoforge.db

# Datepicker per-scenario frontend lockfiles are regenerated by `npm install`
# on every build, so they churn constantly and are not tracked.
datepickers/frontend/envs/*/package-lock.json
datepickers_ood/frontend/envs/*/package-lock.json
