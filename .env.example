# LLM verifier credentials — copy to `.env` and fill in ONE auth setup.
# The harness loads `.env` automatically (python-dotenv). `.env` is gitignored.
#
# Generic LLM_* keys are shown here; the conventional OpenAI / Azure names also
# work (OPENAI_API_KEY, OPENAI_BASE_URL, AZURE_OPENAI_ENDPOINT,
# AZURE_OPENAI_API_KEY, AZURE_OPENAI_DEPLOYMENT, OPENAI_API_VERSION).
#
# Auth mode is auto-detected (override with `verify_cli --auth`):
#   * openai     — non-Azure endpoint (or none) + an API key
#   * azure-key  — an *.azure.com endpoint WITH an API key
#   * azure-ad   — an *.azure.com endpoint WITHOUT an API key (uses
#                  DefaultAzureCredential: `az login` / managed identity;
#                  needs the `azure` extra: pip install -e "harness[azure]")

# --- OpenAI (API key) -------------------------------------------------------
# LLM_API_KEY=sk-...
# LLM_MODEL_NAME=gpt-4o
# LLM_ENDPOINT=            # optional: OpenAI-compatible base URL

# --- Azure OpenAI (API key) -------------------------------------------------
# LLM_ENDPOINT=https://<resource>.openai.azure.com
# LLM_API_KEY=<azure-openai-key>
# LLM_DEPLOYMENT_NAME=gpt-4o
# LLM_MODEL_NAME=gpt-4o
# LLM_API_VERSION=2025-01-01-preview

# --- Azure OpenAI (Azure AD / DefaultAzureCredential) -----------------------
# Leave LLM_API_KEY empty to use Azure AD.
LLM_ENDPOINT=https://<resource>.openai.azure.com
LLM_API_KEY=
LLM_DEPLOYMENT_NAME=gpt-4o
LLM_MODEL_NAME=gpt-4o
LLM_API_VERSION=2025-01-01-preview
